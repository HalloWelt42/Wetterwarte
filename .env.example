# Vorlage. Die echte .env wird per ./wetter setup (tools/setup-env.sh) erzeugt
# und enthaelt projekt-eindeutige Ports plus zufaellige Passwoerter.
COMPOSE_PROJECT_NAME=wetterwarte

BACKEND_PORT=6150
FRONTEND_PORT=6151
DB_PORT=6152
REDIS_PORT=6153

POSTGRES_USER=wetterwarte
POSTGRES_PASSWORD=bitte-generieren
POSTGRES_DB=wetterwarte
DATABASE_URL=postgresql+asyncpg://wetterwarte:bitte-generieren@localhost:6152/wetterwarte

REDIS_URL=redis://localhost:6153/0

APP_SECRET=bitte-generieren
