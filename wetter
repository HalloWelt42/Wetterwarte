#!/usr/bin/env bash
# Ein Einstiegspunkt fuer die Wetterwarte. Datenbanken laufen als Container,
# Backend und Frontend in der Entwicklung auf dem Host.
set -uo pipefail
HIER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HIER"

ensure_env() { [ -f .env ] || bash tools/setup-env.sh; }
load_env() { set -a; . ./.env 2>/dev/null || true; set +a; }

# Produktion: ein Compose steuert alles (Backend, Frontend, DB, Redis).
PROD="docker compose -f docker-compose.prod.yml --env-file .env.prod"

# Ziel-Server fuer den Deploy vom Entwicklungsrechner (per SSH/rsync).
PI_HOST="${PI_HOST:-pi@192.168.178.49}"
PI_PFAD="${PI_PFAD:-/home/pi/wetterwarte}"
ensure_prod_env() {
  [ -f .env.prod ] && return 0
  echo "Es fehlt .env.prod. Aus der Vorlage anlegen:  cp .env.prod.example .env.prod"
  exit 1
}

case "${1:-}" in
  setup)
    bash tools/setup-env.sh ;;
  up|start)
    ensure_env; load_env
    docker compose up -d postgres redis
    echo
    echo "Datenbanken laufen. Entwicklungsserver von Hand starten:"
    echo "  Backend:   cd backend  && uv run uvicorn wetterwarte.main:app --reload --port ${BACKEND_PORT:-6150}"
    echo "  Frontend:  cd frontend && npm run dev"
    ;;
  down|stop)
    docker compose down ;;
  status)
    docker compose ps ;;
  logs)
    shift; docker compose logs -f "$@" ;;
  psql)
    load_env; docker compose exec postgres psql -U "${POSTGRES_USER:-wetterwarte}" -d "${POSTGRES_DB:-wetterwarte}" ;;
  prod-up|prod-start)
    ensure_prod_env; $PROD up -d --build
    echo "Wetterwarte (Produktion) laeuft. Frontend-Port siehe WEB_PORT in .env.prod." ;;
  prod-down|prod-stop)
    ensure_prod_env; $PROD down ;;
  prod-restart)
    # Caddy (vorne) liest das eingebundene deploy/Caddyfile nur beim Start, darum nach dem Bauen neu starten
    ensure_prod_env; $PROD up -d --build && $PROD restart vorne ;;
  prod-status)
    ensure_prod_env; $PROD ps ;;
  prod-logs)
    ensure_prod_env; shift; $PROD logs -f "$@" ;;
  deploy)
    # Vom Entwicklungsrechner: Quellcode zum Server syncen und dort neu bauen/starten.
    echo "Sync -> $PI_HOST:$PI_PFAD"
    rsync -az --delete \
      --exclude '.git' --exclude 'node_modules' --exclude '.venv' --exclude 'dist' \
      --exclude 'data' --exclude '.env' --exclude '.env.prod' --exclude '__pycache__' \
      --exclude '.DS_Store' --exclude '.run' --exclude 'mockups' --exclude 'zertifikate' \
      -e ssh ./ "$PI_HOST:$PI_PFAD/" \
      && ssh "$PI_HOST" "cd '$PI_PFAD' && ./wetter prod-restart" \
      && echo "Deploy fertig. Prüfen: ./wetter rauchtest" ;;
  zertifikat)
    # Blattzertifikat der Hausstelle (mkcert auf diesem Mac) für die sichere Adresse ausstellen und nach
    # $PI_PFAD/zertifikate legen; danach ./wetter deploy (Dienst vorne). Namen über ZERT_NAMEN änderbar.
    NAMEN="${ZERT_NAMEN:-192.168.178.49 raspberrypi-3.fritz.box raspberrypi-3 wetterwarte.fritz.box wetterwarte.local}"
    command -v mkcert >/dev/null || { echo "mkcert fehlt auf diesem Rechner"; exit 1; }
    ARBEIT="$(mktemp -d)"
    trap 'rm -rf "$ARBEIT"' EXIT
    # shellcheck disable=SC2086
    (cd "$ARBEIT" && mkcert -cert-file wetterwarte.pem -key-file wetterwarte-schluessel.pem $NAMEN) || exit 1
    cp "$(mkcert -CAROOT)/rootCA.pem" "$ARBEIT/"
    ssh "$PI_HOST" "mkdir -p '$PI_PFAD/zertifikate'" \
      && scp -q "$ARBEIT"/wetterwarte.pem "$ARBEIT"/wetterwarte-schluessel.pem "$ARBEIT"/rootCA.pem "$PI_HOST:$PI_PFAD/zertifikate/" \
      && ssh "$PI_HOST" "chmod 644 '$PI_PFAD/zertifikate/wetterwarte.pem' '$PI_PFAD/zertifikate/rootCA.pem' && chmod 640 '$PI_PFAD/zertifikate/wetterwarte-schluessel.pem'" \
      && echo "Zertifikat auf $PI_HOST:$PI_PFAD/zertifikate, $(openssl x509 -in "$ARBEIT/wetterwarte.pem" -noout -enddate)" ;;
  rauchtest)
    # Alle Ansichten im echten Aufbau öffnen, Konsolenfehler und gescheiterte Anfragen sammeln (tools/rauchtest.mjs).
    # Ohne Adresse: der Betrieb auf dem Pi (nur lesend).
    node tools/rauchtest.mjs --app "${2:-http://192.168.178.49:8061}" ;;
  mockup)
    ./start-mockups.sh "${2:-start}" ;;
  *)
    echo "Nutzung: ./wetter [setup|up|down|status|logs|psql|mockup|prod-up|prod-down|prod-restart|prod-status|prod-logs|zertifikat|deploy|rauchtest]" ;;
esac
