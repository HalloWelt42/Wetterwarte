# Vorlage fuer die Produktions-Umgebung. Auf dem Server nach .env.prod kopieren
# und die Werte anpassen (vor allem ein echtes Passwort setzen).
# .env.prod selbst gehoert NICHT ins Repo (siehe .gitignore).

# Zugangsdaten der Datenbank (Container-intern).
POSTGRES_USER=wetterwarte
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=wetterwarte

# Nach aussen offener Port des Frontends (die App).
WEB_PORT=8060

# Datenverzeichnis. Auf dem Pi auf die externe SSD zeigen lassen.
DATA_DIR=/mnt/data/wetterwarte

# Lokaler Blitz-Dienst (LAN).
LIGHTNING_BASE=http://192.168.178.49:8100
